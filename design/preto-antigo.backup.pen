            },
            {
              "type": "text",
              "id": "aaQES",
              "fill": "#FFFFFF",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "“PRETO E BRANCO, SEM NENHUMA COR DE DESTAQUE.\nA ÚNICA COR, QUANDO HÁ, VEM DA FOTOGRAFIA.”",
              "lineHeight": 0.92,
              "fontFamily": "Anton",
              "fontSize": 44,
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "aaSIB",
              "fill": "#FFFFFFD1",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "O guia define dois registros. Núcleo (P&B estrito) para deck, proposta, guia e documento — e peças com cor só em rede social e evento, onde a cor é do evento, não da marca. Regra prática do próprio guia: na dúvida, é núcleo. O site é núcleo.",
              "lineHeight": 1.5,
              "fontFamily": "Archivo",
              "fontSize": 17
            },
            {
              "type": "text",
              "id": "aaUMk",
              "fill": "#FFFFFF8C",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "Conferido no arquivo do logo (2300×813): 100% dos pixels opacos são #FFFFFF. A marca não tem cor.",
              "lineHeight": 1.5,
              "fontFamily": "Archivo",
              "fontSize": 15
            }
          ]
        },
