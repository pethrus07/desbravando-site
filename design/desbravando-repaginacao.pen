                      "content": "O TRECHO MAIS BRUTO DO LITORAL GAÚCHO.",
                      "textGrowth": "fixed-width",
                      "fontFamily": "Anton",
                      "fontSize": 30,
                      "fontWeight": "400",
                      "lineHeight": 1.04,
                      "letterSpacing": -0.4,
