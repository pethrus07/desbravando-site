          "id": "aSWo1",
          "layout": "vertical",
          "width": "fill_container",
          "padding": 30,
          "gap": 14,
          "fill": "#FFFFFF",
          "children": [
            {
              "type": "text",
              "id": "aSShz",
              "content": "POR QUE CLARO, E NÃO PRETO",
              "textGrowth": "auto",
              "fontFamily": "Archivo",
              "fontSize": 11,
              "fontWeight": "600",
              "lineHeight": 1.2,
              "letterSpacing": 3,
              "fill": "#717171",
              "name": "sobrelinha"
            },
            {
              "type": "text",
              "id": "aSUli",
              "content": "O site de hoje é claro (#F2F2F2), centrado, com blocos pretos. A primeira proposta virou tudo preto e ficou destoante — era um site novo, não uma repaginação. E preto + tipo condensado gigante + foto sangrando é a fórmula mais batida que existe. Aqui o fundo continua claro e o preto vira pontuação.",
              "textGrowth": "fixed-width",
              "fontFamily": "Archivo",
              "fontSize": 16,
              "fontWeight": "400",
              "lineHeight": 1.6,
              "fill": "#717171",
              "width": 900
            }
          ]
        },
