              "gap": 50,
              "alignItems": "start",
              "children": [
                {
                  "type": "frame",
                  "id": "aSDRu",
                  "layout": "vertical",
                  "width": "fill_container",
                  "gap": 14,
                  "children": [
                    {
                      "type": "text",
                      "id": "aSzJ2",
                      "content": "A REGRA",
                      "textGrowth": "auto",
                      "fontFamily": "Archivo",
                      "fontSize": 11,
                      "fontWeight": "600",
                      "lineHeight": 1.2,
                      "letterSpacing": 3,
                      "fill": "#717171",
                      "name": "sobrelinha"
                    },
                    {
                      "type": "text",
                      "id": "aSBNL",
                      "content": "“PRETO E BRANCO, SEM NENHUMA COR DE DESTAQUE.\nA ÚNICA COR, QUANDO HÁ, VEM DA FOTOGRAFIA.”",
                      "textGrowth": "fixed-width",
                      "fontFamily": "Anton",
                      "fontSize": 34,
                      "fontWeight": "400",
                      "lineHeight": 1.08,
                      "letterSpacing": -0.4,
                      "fill": "#111111",
                      "width": "fill_container"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "aSJ2F",
                  "layout": "vertical",
                  "width": 480,
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "aSFVd",
                      "content": "Do guia de identidade que já existe. O site é registro NÚCLEO — o mesmo dos decks, propostas e documentos.",
                      "textGrowth": "fixed-width",
                      "fontFamily": "Archivo",
                      "fontSize": 16,
                      "fontWeight": "400",
                      "lineHeight": 1.6,
                      "fill": "#717171",
                      "width": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "aSHYW",
                      "content": "Conferido no arquivo do logo (2300×813): 100% dos pixels opacos são #FFFFFF. A marca não tem cor.",
                      "textGrowth": "fixed-width",
                      "fontFamily": "Archivo",
                      "fontSize": 13.5,
                      "fontWeight": "400",
                      "lineHeight": 1.5,
                      "fill": "#717171",
                      "width": "fill_container"
