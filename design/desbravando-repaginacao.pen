                },
                {
                  "type": "text",
                  "id": "aSljX",
                  "content": "V3 · ÍNDICE TIPOGRÁFICO",
                  "textGrowth": "auto",
                  "fontFamily": "Anton",
                  "fontSize": 72,
                  "fontWeight": "400",
                  "lineHeight": 1,
                  "letterSpacing": -0.5,
                  "fill": "#111111"
                },
                {
                  "type": "text",
                  "id": "aSnnG",
                  "content": "A página abre como um sumário, não como uma vitrine. Tipo grande, fio fino, dado tabulado, foto pequena e contida. O preto é pontuação — nav, faixa de pausa e botão —, não fundo.",
                  "textGrowth": "fixed-width",
                  "fontFamily": "Archivo",
                  "fontSize": 18,
                  "fontWeight": "400",
                  "lineHeight": 1.6,
                  "fill": "#717171",
                  "width": "fill_container"
                }
              ]
            },
            {
              "type": "frame",
              "id": "aStyR",
              "layout": "vertical",
